# ============================================================
# Конфиг агента (правится на каждом сервере)
# ============================================================

# Идентификатор этого сервера (произвольная строка, будет видна в уведомлениях)
server_id: "u4435"

# Сетевой интерфейс, по которому считаем трафик
interface: "eth0"

# Лимит трафика в байтах (входящий + исходящий)
# Удобные значения:
#   100 GB  = 100 000 000 000     (10 GB = 10 000 000 000)
#   1 TB    = 1 000 000 000 000   (большинство хостингов считают в TB / GB, 10⁹/10¹²)
#   1 TiB   = 1 099 511 627 776   (vnstat считает в TiB, 2⁴⁰)
limit_bytes: 30000000000

# День месяца, когда счётчик трафика обнуляется (1-28)
# Должен совпадать с расчётным периодом вашего хостинга
reset_day: 1

# Пороги уведомлений (можно править, бот всё равно прочитает)
# percent — отправляется при достижении % от лимита
# remaining_bytes — отправляется когда осталось меньше N байт
thresholds:
  percent: [50, 75, 90]
  remaining_bytes: [5497558138880]   # 5 TiB

# Что делать при превышении лимита
# true = заблокировать весь трафик через ufw default deny
# false = только уведомить
auto_block: true

# ============================================================
# Связь с ботом
# ============================================================

# URL центрального бота (поднимается отдельно, см. bot/)
bot_url: "http://10.0.0.1:8080"

# Общий секрет (должен совпадать с bot/config.yaml)
shared_secret: "REPLACE_WITH_LONG_RANDOM_STRING"

# Как часто слать отчёт боту (секунды)
report_interval: 3600    # раз в час

# Как часто проверять трафик локально (секунды)
check_interval: 300      # раз в 5 минут
